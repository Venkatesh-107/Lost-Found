# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Environment variables template
# Lost & Found PWA
# Copy to .env and fill in your values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PocketBase ────────────────────────────────────────────────────────────────
# URL of your running PocketBase instance
VITE_PB_URL=http://127.0.0.1:8090

# ── Node.js Companion Server ──────────────────────────────────────────────────
# Port for the Express cleanup/notify server
NODE_PORT=4000

# PocketBase Admin credentials (used by Node.js server for cron cleanup)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=your_admin_password

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME="Lost & Found"
VITE_CLAIM_EXPIRY_DAYS=20
